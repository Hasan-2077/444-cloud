AWS_REGION=us-east-2
AMI_ID=your-amazon-linux-2023-ami-id
INSTANCE_TYPE=t3.micro
KEY_NAME=your-key-pair-name

AZ_A=us-east-2a
AZ_B=us-east-2b

APP_SECURITY_GROUP_ID=sg-your-security-group-id
ALLOWED_CIDR=your-public-ip/32
APP_PORT=3000

# Weather tier
WEATHER_ROLE_NAME=itmo-444-544-final-weather-role
WEATHER_PROFILE_NAME=itmo-444-544-final-weather-profile
WEATHER_LT_NAME=itmo-444-544-final-weather-lt
WEATHER_TG_NAME=itmo-444-544-final-weather-tg
WEATHER_ASG_NAME=itmo-444-544-final-weather-asg
WEATHER_LISTENER_PORT=8080

# Advisor tier
ADVISOR_ROLE_NAME=itmo-444-544-final-advisor-role
ADVISOR_PROFILE_NAME=itmo-444-544-final-advisor-profile
ADVISOR_LT_NAME=itmo-444-544-final-advisor-lt
ADVISOR_TG_NAME=itmo-444-544-final-advisor-tg
ADVISOR_ASG_NAME=itmo-444-544-final-advisor-asg
ADVISOR_LISTENER_PORT=8081

# Application Load Balancer
ALB_NAME=itmo-444-544-final-alb
ALB_SG_NAME=itmo-444-544-final-alb-sg

# DynamoDB
DYNAMODB_TABLE_NAME=itmo-444-544-final-weather-advisor
DYNAMODB_TTL_ATTRIBUTE=expiresAt
DYNAMODB_RETRY_MS=30000

# Gemini
GEMINI_PARAM_NAME=/itmo-444-544/final/gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
KEY_CACHE_SECONDS=60
GEMINI_DAILY_CAP=20

# Email abuse control
EMAIL_LIMIT=3
EMAIL_LIMIT_WINDOW_SECONDS=3600

# Amazon SES
SES_FROM_EMAIL=your-verified-sender@example.com
SES_REGION=us-east-2

# NWS User-Agent contact
CONTACT_EMAIL=your-email@example.com
